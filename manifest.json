{
  "manifest_version": 3,
  "name": "Uwufier",
  "version": "1.0",

  "description": "An add-on that uwufies your browser :3",

  "icons": {
    "48": "icons/uwu.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "uwufier@acanofdrpepper.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["uwufier.js"]
    }
  ]
}
